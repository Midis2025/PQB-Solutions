# -----------------------------------------------------------------------------
# PQB Solutions – Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to version control.

# Resend API Key (Server-side only — never prefix with NEXT_PUBLIC_)
# Obtain from your Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address configured and verified in Resend.
# In test mode before domain verification, you can use: onboarding@resend.dev
# In production with verified domain pqbsolutions.com:
RESEND_FROM_EMAIL=PQB Solutions <notifications@pqbsolutions.com>

# Recipient email address for contact form notifications (admin/owner inbox).
# Defaults to site.email (Support@pqbsolutions.com) if not specified.
CONTACT_NOTIFICATION_EMAIL=Support@pqbsolutions.com

# WhatsApp Business contact number in international format without '+' or spaces (e.g. 18255220889)
NEXT_PUBLIC_WHATSAPP_NUMBER=18255220889


